// FlowDesk AI — Prisma Schema

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  MARKETING
  SUPPORT
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  LOST
  INACTIVE
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}

enum ChannelType {
  WHATSAPP
  EMAIL
  SMS
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("GROWTH") // STARTER, GROWTH, BUSINESS, ENTERPRISE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  contacts     Contact[]
  tags         Tag[]
  automations  Automation[]
  events       Event[]
  tasks        Task[]
  campaigns    Campaign[]
  segments     Segment[]
  integrations Integration[]
  apiKeys      ApiKey[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String       @unique
  passwordHash   String?
  role           UserRole     @default(SALES)
  avatarUrl      String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedContacts Contact[]       @relation("AssignedToUser")
  assignedTasks    Task[]          @relation("AssignedTasks")
  createdTasks     Task[]          @relation("CreatedTasks")
  timelineEvents   TimelineEvent[]
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  email          String?
  phone          String?      // E.164 normalized
  company        String?
  title          String?
  source         String       @default("MANUAL") // EXCEL, OCR_IMAGE, WEB_FORM, WHATSAPP, API
  status         LeadStatus   @default(NEW)
  leadScore      Int          @default(0)
  
  location       String?
  customFields   Json?        // Flexible key-values
  
  assignedToId   String?
  assignedTo     User?        @relation("AssignedToUser", fields: [assignedToId], references: [id])
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tags           ContactTag[]
  tasks          Task[]
  timeline       TimelineEvent[]
  messages       Message[]
  eventAttendees EventAttendee[]
  automationRuns AutomationRun[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, status])
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("#3B82F6")
  createdAt      DateTime     @default(now())

  contacts       ContactTag[]

  @@unique([organizationId, name])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  
  type        String   // "WHATSAPP_SENT", "EMAIL_OPENED", "STATUS_CHANGED", "TASK_CREATED", "NOTE"
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([contactId, createdAt])
}

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         AutomationStatus @default(DRAFT)
  
  flowDefinition Json             // React Flow { nodes: [...], edges: [...] }
  triggerType    String           // "CONTACT_CREATED", "TAG_ADDED", etc.
  
  executionCount Int              @default(0)
  successCount   Int              @default(0)
  failureCount   Int              @default(0)
  lastRunAt      DateTime?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  runs           AutomationRun[]
}

model AutomationRun {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  
  status        String     // "PENDING", "IN_PROGRESS", "WAITING_DELAY", "COMPLETED", "FAILED"
  currentNodeId String?
  stateData     Json?
  logs          Json?
  errorMessage  String?

  startedAt     DateTime   @default(now())
  completedAt   DateTime?

  @@index([automationId, status])
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  channel        ChannelType
  direction      MessageDirection
  status         MessageStatus    @default(QUEUED)
  
  from           String
  to             String
  content        String
  templateName   String?
  mediaUrl       String?
  externalId     String?
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([contactId, createdAt])
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?
  type           String       // "WEBINAR", "WORKSHOP", "DEMO", "CONFERENCE"
  eventDate      DateTime
  durationMins   Int          @default(60)
  locationUrl    String?
  maxCapacity    Int?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendees      EventAttendee[]
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  contactId String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status    String   @default("REGISTERED")
  createdAt DateTime @default(now())

  @@unique([eventId, contactId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?
  dueDate        DateTime
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  
  assignedToId   String?
  assignedTo     User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById    String?
  createdBy      User?        @relation("CreatedTasks", fields: [createdById], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, dueDate, status])
}

model Segment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  filters        Json
  createdAt      DateTime     @default(now())

  campaigns      Campaign[]
}

model Campaign {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segmentId       String?
  segment         Segment?     @relation(fields: [segmentId], references: [id])
  
  name            String
  channel         ChannelType
  templateName    String?
  content         String?
  scheduledAt     DateTime?
  status          String       @default("DRAFT")
  
  totalRecipients Int          @default(0)
  sentCount       Int          @default(0)
  deliveredCount  Int          @default(0)
  failedCount     Int          @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       // "WHATSAPP_CLOUD", "RESEND", "SMTP", "GOOGLE_SHEETS", "WEBHOOK"
  credentials    Json
  isEnabled      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  prefix         String
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
}
